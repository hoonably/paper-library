{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "updates"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reason", "changes"],
        "properties": {
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "value"],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "category", "subcategory", "venue", "year", "track", "workshop",
                    "presentation", "title", "authors", "affiliation", "summary", "novelty", "site"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
