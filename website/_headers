/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/project-directory/*
  Cache-Control: public, max-age=300

/embed/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://jeonghoonpark.com https://www.jeonghoonpark.com
